{
  "name": "lens-and-sync",
  "version": "0.0.1",
  "private": true,
  "description": "DishLens and DriveSync in one repo.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @lens-and-sync/shared-db run generate",
    "db:migrate": "pnpm --filter @lens-and-sync/shared-db run migrate",
    "docs:dev": "pnpm --filter @lens-and-sync/docs run dev",
    "docs:build": "pnpm --filter @lens-and-sync/docs run build",
    "docs:preview": "pnpm --filter @lens-and-sync/docs run preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
