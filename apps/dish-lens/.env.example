# --- Server ---
PORT=4002
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (password-based register/login, rotating JWT refresh tokens) ---
# Access tokens are short-lived bearer tokens verified on every protected request.
# Refresh tokens are longer-lived, stored as sha256(token) in Postgres, and
# rotated on every /auth/refresh call — using a refresh token a second time
# after rotation returns 401 (replay detection).
# Use a strong random value for both secrets in production (e.g. openssl rand -hex 32).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Google Cloud (single service account, used by both Vision and Cloud Storage) ---
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CREDENTIALS_JSON=

# --- Recipe generation (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Nutrition lookup (Edamam) ---
NUTRITION_API_PROVIDER=edamam
NUTRITION_API_APP_ID=
NUTRITION_API_APP_KEY=

# --- Object storage (Google Cloud Storage, pre-signed upload/read URLs) ---
GCS_BUCKET_NAME=
# How long a signed read URL for a stored dish photo stays valid.
GCS_SIGNED_URL_EXPIRY_SECONDS=3600

# --- Redis (session state + rate-limit store) ---
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL_SECONDS=1800

# --- Database (shared with drive-sync, separate schema/tables) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lens_and_sync_dev

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=20
# iPhone 14 Pro+ ProRAW/48MP output tops out around 8064x6048 - 8192 leaves
# headroom for that without allowing arbitrary huge (decompression-bomb) images
MAX_IMAGE_DIMENSION_PX=8192

# --- Blur detection ---
BLUR_VARIANCE_THRESHOLD=100

# --- Dish detection (Google Vision label classification) ---
# Score a specific (non-category, non-raw-ingredient) label needs to count as
# a candidate dish name.
DISH_CONFIDENCE_THRESHOLD=0.6
# Score a generic category label ("Food", "Dish", "Cuisine") needs to count as
# evidence the photo is food-related at all.
FOOD_EVIDENCE_THRESHOLD=0.5

# --- Rate limiting (Redis-backed via rate-limit-redis) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Per-user upload rate limiting (distinct from the per-IP limit above) ---
# iOS clients on poor cellular connections may retry uploads aggressively -
# this window/count needs to tolerate legitimate retries without allowing abuse
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX_UPLOADS=20

# --- Email (Resend — https://resend.com) ---
# Used for email verification, OTP login, and password reset.
# EMAIL_FROM must be a verified sender in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=DishLens <noreply@yourdomain.com>
# Base URL used to construct verification and reset links sent in emails.
# For production: your Railway URL or custom domain. For local dev: http://localhost:4002
APP_BASE_URL=http://localhost:4002

# NOTE: no separate moderation provider/key — NSFW/inappropriate content
# detection reuses the SafeSearch annotation returned by the same Vision
# call used for dish detection (see src/vision/index.ts).
