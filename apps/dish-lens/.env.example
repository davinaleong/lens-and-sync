# --- Server ---
PORT=4002
NODE_ENV=development

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Google Vision ---
GOOGLE_VISION_CREDENTIALS_JSON=

# --- Recipe generation (LLM) ---
LLM_PROVIDER_API_KEY=
LLM_MODEL=

# --- Nutrition lookup ---
NUTRITION_API_PROVIDER=edamam
NUTRITION_API_APP_ID=
NUTRITION_API_APP_KEY=

# --- Object storage (pre-signed uploads) ---
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- Redis (session state) ---
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL_SECONDS=1800

# --- Database (shared with drive-sync, separate schema/tables) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lens_and_sync_dev

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=20

# --- Blur detection ---
BLUR_VARIANCE_THRESHOLD=100

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Moderation ---
MODERATION_PROVIDER_API_KEY=
