{
  "name": "@lens-and-sync/dish-lens",
  "version": "0.0.1",
  "private": true,
  "description": "Dish photo to recipe + nutrition API, consumed by the iOS client.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lens-and-sync/shared-auth": "workspace:*",
    "@lens-and-sync/shared-config": "workspace:*",
    "@lens-and-sync/shared-db": "workspace:*",
    "@lens-and-sync/shared-logger": "workspace:*",
    "@lens-and-sync/shared-types": "workspace:*",
    "@lens-and-sync/shared-utils": "workspace:*",
    "@anthropic-ai/sdk": "^0.27.0",
    "@google-cloud/storage": "^7.12.0",
    "@google-cloud/vision": "^4.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "file-type": "^19.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
