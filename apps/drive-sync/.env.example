# --- Server ---
PORT=4001
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (shared JWT scheme with dish-lens, via @lens-and-sync/shared-auth) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Rate limiting (Redis-backed via rate-limit-redis) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Google Drive (service account, scoped to target folder(s) only) ---
GOOGLE_CLOUD_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_IDS=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=drive-sync-dev
PINECONE_NAMESPACE=default

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the target Pinecone index's own dimension. Leave unset to use
# the model's default (1536) - only correct if the Pinecone index was
# created with that same default.
EMBEDDING_DIMENSIONS=

# --- Database (shared with dish-lens, separate schema/tables) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lens_and_sync_dev

# --- Redis (BullMQ: sync job scheduling + locking, prevents overlapping runs) ---
REDIS_URL=redis://localhost:6379
SYNC_QUEUE_NAME=drive-sync-jobs

# --- Sync scheduling ---
SYNC_CRON_SCHEDULE="*/15 * * * *"
