# --- Server ---
PORT=4001
NODE_ENV=development

# --- Google Drive (service account, scoped to target folder(s) only) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_IDS=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=drive-sync-dev
PINECONE_NAMESPACE=default

# --- Embeddings ---
EMBEDDING_PROVIDER_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Database (shared with dish-lens, separate schema/tables) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lens_and_sync_dev

# --- Sync scheduling ---
SYNC_CRON_SCHEDULE="*/15 * * * *"
