// Shared Prisma schema for drive-sync and dish-lens.
// See _internal-docs/03-monorepo-structure.md for how this package is consumed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Shared identity ---

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  emailVerified      Boolean             @default(false)
  createdAt          DateTime            @default(now())
  refreshTokens      RefreshToken[]
  savedChats         SavedChat[]
  mealPlans          MealPlan[]
  verificationTokens VerificationToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// --- DriveSync ---

model DriveFile {
  id               String   @id @default(uuid())
  driveFileId      String   @unique
  title            String
  sourceUrl        String
  contentHash      String
  driveModifiedTime DateTime
  chunkIds         String[]
  lastSyncedAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([contentHash])
}

// --- DishLens ---

// Write-once: no application code path may update a row after creation.
model SavedChat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dishName  String
  messages  Json
  createdAt DateTime @default(now())

  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_OTP
}

// Single table for all three token-based flows: email verification, password
// reset, and OTP login. Type field discriminates; tokenHash is always
// sha256 of the raw token/code so the plaintext never touches the DB.
model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

model MealPlan {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  name      String
  entries   MealEntry[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealEntry {
  id         String    @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  mealType   MealType
  dishName   String
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([mealPlanId])
}
