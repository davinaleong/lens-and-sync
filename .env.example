# Root-level vars shared across the workspace (used by packages/shared-db
# and infra/docker-compose.yml). Each app also has its own .env.example
# with service-specific keys — see apps/drive-sync/.env.example and
# apps/dish-lens/.env.example.

NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lens_and_sync_dev
REDIS_URL=redis://localhost:6379
